{
    "name": "n8n-nodes-lookio",
    "version": "0.1.0",
    "description": "n8n node for Lookio API",
    "license": "MIT",
    "homepage": "https://lookio.app",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "Lookio",
        "email": "contact@lookio.app"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DuvInc/n8n-nodes-lookio.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "credentials": [
            "dist/credentials/LookioApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Lookio/Lookio.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
